# =============================================================================
# Fatigue Analysis Tool — Environment Variables
#
# Copy this file to .env.local for local development, or pass these
# variables to your Docker container for production.
# =============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Session Cookie Secret ----
# Used to sign session cookies. Change this in production!
SESSION_COOKIE_SECRET=change-me-in-production

# ---- Next.js ----
NEXT_TELEMETRY_DISABLED=1

# ---- Analysis Defaults (optional overrides) ----
# MAX_SCATTER_POINTS=10000
# MAX_3D_POINTS=10000
