{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@fatigue/types": ["../../packages/types/dist"],
      "@fatigue/core": ["../../packages/core/dist"],
      "@fatigue/data": ["../../packages/data/dist"],
      "@fatigue/ui": ["../../packages/ui/dist"]
    },
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "noEmit": true,
    "incremental": true
  },
  "include": ["src", "next-env.d.ts", ".next/types/**/*.ts"],
  "references": [
    { "path": "../../packages/types" },
    { "path": "../../packages/core" },
    { "path": "../../packages/data" },
    { "path": "../../packages/ui" }
  ],
  "exclude": ["node_modules"]
}
