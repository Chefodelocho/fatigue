# Auto-detect text files and normalize line endings
* text=auto

# Override for binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text

# Lock file — treat as binary to avoid merge conflicts
pnpm-lock.yaml -diff

# Ensure consistent line endings
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
